---
import LegalPage from '@components/LegalPage.astro';
import { localizedUrl, useTranslations } from '@i18n/utils';
import type { Lang } from '@i18n/ui';

const lang: Lang = 'en';
const t = useTranslations(lang);
const sections = [
  ['terms.s1h', 'terms.s1'],
  ['terms.s2h', 'terms.s2'],
  ['terms.s3h', 'terms.s3'],
  ['terms.s4h', 'terms.s4'],
  ['terms.s5h', 'terms.s5'],
  ['terms.s6h', 'terms.s6'],
  ['terms.s7h', 'terms.s7'],
  ['terms.s8h', 'terms.s8'],
  ['terms.s9h', 'terms.s9'],
  ['terms.s10h', 'terms.s10'],
  ['terms.s11h', 'terms.s11'],
  ['terms.s12h', 'terms.s12'],
] as const;
---

<LegalPage
  lang={lang}
  esPath="terminos"
  enPath="terms"
  title={t('meta.terms.title')}
  description={t('meta.terms.description')}
  h1Key="terms.h1"
  updatedKey="terms.updated"
  sections={sections}
  backHref="/en/"
  backKey="terms.back"
  crossKey="terms.cross"
  crossHref={localizedUrl(lang, 'privacy')}
/>
