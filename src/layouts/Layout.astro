---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "@styles/global.css";
import "@styles/specular.css";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { localeUrl, useTranslations } from "@i18n/utils";
import { defaultLang, type Lang } from "@i18n/ui";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Slug of the page in each locale, without slashes ('' for the locale root).
   *  Slugs may differ per language (e.g. terminos / terms). */
  esPath?: string;
  enPath?: string;
}

const { lang, title, description, esPath = "", enPath = "" } = Astro.props;
const t = useTranslations(lang);
const isBlogPage = esPath.startsWith("blog") || enPath.startsWith("blog");

const siteUrl = Astro.site ?? new URL("https://noxell.dev");
const canonical = new URL(Astro.url.pathname, siteUrl);
const ogImage = new URL("/logorojo.png", siteUrl);
const pathFor = (locale: Lang) => (locale === defaultLang ? esPath : enPath);
const urlFor = (locale: Lang) =>
  new URL(localeUrl(locale, pathFor(locale) || undefined), siteUrl);
const altLocale: Lang = lang === defaultLang ? "en" : defaultLang;
const altUrl = localeUrl(altLocale, pathFor(altLocale) || undefined);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={urlFor("es")} />
    <link rel="alternate" hreflang="en" href={urlFor("en")} />
    <link rel="alternate" hreflang="x-default" href={urlFor(defaultLang)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/png" href="/logorojo.png" />
    <link rel="apple-touch-icon" href="/logorojo.png" />
    <meta name="theme-color" content="#0a0a0d" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class:list={{ "blog-page": isBlogPage }}>
    <div class="aurora" data-aurora aria-hidden="true"></div>
    <a class="skip-link" href="#main">{t("nav.skip")}</a>
    <Header lang={lang} altUrl={altUrl} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import "../scripts/aurora";
      import "../scripts/glow";
      import "../scripts/motion";
      import "../scripts/specular";
    </script>
  </body>
</html>
