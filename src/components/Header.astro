---
import type { Lang } from "@i18n/ui";
import { localeUrl, useTranslations } from "@i18n/utils";

interface Props {
  lang: Lang;
  altUrl: string;
}

const { lang, altUrl } = Astro.props;
const t = useTranslations(lang);
const base = localeUrl(lang);
---

<header class="site-header">
  <div class="pill">
    <a class="brand" href={base}>
      <span class="mark"
        ><img
          src="/logorojo.png"
          alt=""
          width="34"
          height="34"
          loading="eager"
        /></span
      >
      <span class="word">noxell<span class="dot">.dev</span></span>
    </a>
    <nav id="main-nav" aria-label={t("nav.menu")}>
      <a href={`${base}#servicios`}>{t("nav.services")}</a>
      <a href={`${base}#portfolio`}>{t("nav.portfolio")}</a>
      <a href={localeUrl(lang, "blog")}>{t("nav.blog")}</a>
      <a href={`${base}#metodologia`}>{t("nav.method")}</a>
      <a href={`${base}#contacto`}>{t("nav.contact")}</a>
    </nav>
    <div class="actions">
      <div class="lang" role="group" aria-label="Idioma / Language">
        <a
          href={lang === "es" ? Astro.url.pathname : altUrl}
          hreflang={lang === "es" ? "es" : "es"}
          aria-current={lang === "es" ? "page" : undefined}
          class:list={["lang-opt", { active: lang === "es" }]}>ES</a
        >
        <a
          href={lang === "en" ? Astro.url.pathname : altUrl}
          hreflang={lang === "en" ? "en" : "en"}
          aria-current={lang === "en" ? "page" : undefined}
          class:list={["lang-opt", { active: lang === "en" }]}>EN</a
        >
      </div>
      <a
        class="btn-specular btn-specular--sm header-cta"
        data-specular
        href={`${base}#contacto`}
      >
        <span class="spec-fx" aria-hidden="true"></span>
        <span class="btn-label">{t("nav.cta")}</span>
      </a>
      <button
        class="menu-toggle"
        type="button"
        aria-controls="main-nav"
        aria-expanded="false"
        aria-label={t("nav.open")}
        data-open-label={t("nav.open")}
        data-close-label={t("nav.close")}
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector(".site-header");
  const pill = header?.querySelector(".pill");
  const toggle = header?.querySelector<HTMLButtonElement>(".menu-toggle");
  const nav = header?.querySelector<HTMLElement>("#main-nav");

  if (pill && toggle && nav) {
    const openLabel = toggle.dataset.openLabel ?? "Open menu";
    const closeLabel = toggle.dataset.closeLabel ?? "Close menu";

    const closeMenu = () => {
      pill.classList.remove("menu-open");
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", openLabel);
    };

    toggle.addEventListener("click", () => {
      const isOpen = pill.classList.toggle("menu-open");
      toggle.setAttribute("aria-expanded", String(isOpen));
      toggle.setAttribute("aria-label", isOpen ? closeLabel : openLabel);
    });

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeMenu();
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 12px;
    z-index: 40;
    padding-inline: 16px;
  }

  /* floating iOS-style glass pill */
  .pill {
    max-width: 920px;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    height: 62px;
    padding: 0 10px 0 20px;
    border-radius: 999px;
    background: rgba(15, 15, 21, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    box-shadow: 0 14px 44px rgba(0, 0, 0, 0.4);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  .mark {
    position: relative;
    display: block;
    width: 34px;
    height: 34px;
    overflow: hidden;
  }

  /* Measured from logoazul.png (1094x976, knot = 504px, centered):
     sizing the img to 191% of the tile renders the knot at exactly 88%. */
  .mark img {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 191%;
    height: auto;
    transform: translate(-50%, -50%);
  }

  .word {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.02rem;
  }

  .dot {
    color: var(--red-text);
  }

  nav {
    display: flex;
    gap: 26px;
  }

  nav a {
    font-size: 0.92rem;
    color: var(--muted);
    padding: 10px 2px;
    transition: color var(--fast) var(--ease);
  }

  nav a:hover {
    color: var(--fg);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--fg);
    background: rgba(255, 255, 255, 0.06);
    cursor: pointer;
  }

  .menu-toggle span {
    width: 15px;
    height: 1.5px;
    background: currentColor;
    transition:
      transform var(--fast) var(--ease),
      opacity var(--fast) var(--ease);
  }

  .pill.menu-open .menu-toggle span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .pill.menu-open .menu-toggle span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  /* iOS segmented language control */
  .lang {
    display: flex;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    padding: 3px;
  }

  .lang-opt {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--muted);
    padding: 6px 11px;
    border-radius: 999px;
    transition:
      color var(--fast) var(--ease),
      background-color var(--fast) var(--ease);
  }

  .lang-opt:hover:not(.active) {
    color: var(--fg);
  }

  .lang-opt.active {
    background: rgba(255, 255, 255, 0.14);
    color: var(--fg);
  }

  @media (max-width: 720px) {
    .pill {
      position: relative;
      padding-left: 14px;
    }

    .header-cta { display: none; }

    .menu-toggle { display: inline-flex; }

    nav {
      display: none;
      position: absolute;
      top: calc(100% + 10px);
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 2px;
      padding: 8px;
      border: 1px solid var(--border-strong);
      border-radius: 20px;
      background: rgba(15, 15, 21, 0.97);
      box-shadow: 0 18px 44px rgba(0, 0, 0, 0.42);
      backdrop-filter: blur(18px) saturate(160%);
      -webkit-backdrop-filter: blur(18px) saturate(160%);
    }

    .pill.menu-open nav {
      display: flex;
    }

    nav a {
      display: flex;
      align-items: center;
      min-height: 44px;
      padding: 9px 14px;
      border-radius: 12px;
    }

    nav a:hover,
    nav a:focus-visible {
      background: rgba(255, 255, 255, 0.08);
    }
  }
</style>
