---
import { getCollection } from "astro:content";
import type { Lang } from "@i18n/ui";
import { localeUrl, useTranslations } from "@i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const posts = (await getCollection("blog"))
  .filter((post) => post.data.locale === lang && !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<section class="listing">
  <div class="wrap">
    <a class="back" href={localeUrl(lang)}>{t("blog.back")} </a>
    <div class="heading">
      <span class="overline-pill">{t("blog.overline")}</span>
      <h1>{t("blog.title")}</h1>
      <p class="lead">{t("blog.lead")}</p>
    </div>
    <div class="posts">
      {
        posts.map((post) => (
          <article class="post">
            <div class="post-meta">
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString(lang === "es" ? "es-ES" : "en-US", {
                  dateStyle: "long",
                })}
              </time>
              <span>{post.data.tags.join(" · ")}</span>
            </div>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <a class="read" href={localeUrl(lang, `blog/${post.id.split("/").pop()}`)}>
              {t("blog.read")} →
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .listing {
    min-height: 70vh;
    padding: 80px 0 120px;
    background: transparent;
  }

  .back {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
    margin-bottom: 64px;
  }

  .back:hover { color: var(--fg); }
  .heading { max-width: 680px; margin-bottom: 60px; }

  h1 {
    font-size: clamp(2.5rem, 6vw, 4.6rem);
    line-height: 1;
    letter-spacing: -0.05em;
    margin: 18px 0 22px;
  }

  .posts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .post {
    display: flex;
    flex-direction: column;
    min-height: 270px;
    padding: 32px;
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .post-meta {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h2 { font-size: 1.5rem; line-height: 1.15; margin: 30px 0 14px; }
  .post p { color: var(--muted); }
  .read { margin-top: auto; padding-top: 28px; color: var(--red-text); font-weight: 600; }
  .read:hover { text-decoration: underline; text-underline-offset: 5px; }

  @media (max-width: 700px) {
    .posts { grid-template-columns: 1fr; }
    .post { min-height: 0; }
  }
</style>
