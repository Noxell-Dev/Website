---
import Terminal from '@components/Terminal.astro';
import { useTranslations } from '@i18n/utils';
import type { Lang } from '@i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero">
  <div class="wrap grid">
    <div class="copy">
      <p class="overline" data-rise>{t('hero.overline')}</p>
      <h1 data-rise>{t('hero.title')}</h1>
      <p class="lead" data-rise>{t('hero.lead')}</p>
      <div class="cta-row" data-rise>
        <a class="btn-specular btn-specular--md" data-specular href="#contacto">
          <span class="spec-fx" aria-hidden="true"></span>
          <span class="btn-label">{t('hero.cta')}</span>
        </a>
        <a class="link-arrow" href="#metodologia">{t('hero.secondary')} →</a>
      </div>
      <p class="note" data-rise>{t('hero.note')}</p>
    </div>
    <div data-rise>
      <Terminal lang={lang} />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 120px 0 112px;
  }

  .grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 56px;
    align-items: center;
  }

  .copy .overline { margin-bottom: 22px; }

  h1 {
    font-size: clamp(2.8rem, 5.6vw, 4.6rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.04em;
    margin-bottom: 24px;
    max-width: 14em;
    text-wrap: balance;
  }

  .lead { margin-bottom: 36px; }

  .cta-row {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .note {
    margin-top: 22px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .hero { padding: 76px 0; }
    .grid { grid-template-columns: 1fr; gap: 44px; }
  }
</style>
