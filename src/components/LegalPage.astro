---
import Layout from '@layouts/Layout.astro';
import { useTranslations, type DictKey } from '@i18n/utils';
import type { Lang } from '@i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Slug of this page in each locale (hreflang + language switch). */
  esPath: string;
  enPath: string;
  h1Key: DictKey;
  updatedKey: DictKey;
  sections: readonly (readonly [DictKey, DictKey])[];
  backHref: string;
  backKey: DictKey;
  crossKey: DictKey;
  crossHref: string;
}

const {
  lang,
  title,
  description,
  esPath,
  enPath,
  h1Key,
  updatedKey,
  sections,
  backHref,
  backKey,
  crossKey,
  crossHref,
} = Astro.props;
const t = useTranslations(lang);
---

<Layout lang={lang} esPath={esPath} enPath={enPath} title={title} description={description}>
  <article class="legal">
    <h1>{t(h1Key)}</h1>
    <p class="updated">{t(updatedKey)}</p>
    {
      sections.map(([heading, body]) => (
        <>
          <h2>{t(heading)}</h2>
          <p>{t(body)}</p>
        </>
      ))
    }
    <a class="cross" href={crossHref}>{t(crossKey)}</a>
    <br />
    <a class="back" href={backHref}>{t(backKey)}</a>
  </article>
</Layout>

<style>
  .legal {
    max-width: 760px;
    margin-inline: auto;
    padding: 80px 24px 120px;
  }

  h1 {
    font-size: clamp(2rem, 3.5vw, 2.6rem);
    letter-spacing: -0.03em;
    margin-bottom: 10px;
  }

  .updated {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
    margin-bottom: 44px;
  }

  h2 {
    font-family: var(--font-sans);
    font-size: 1.12rem;
    font-weight: 600;
    margin: 36px 0 8px;
  }

  p:not(.updated) { color: var(--muted); }

  .cross,
  .back {
    display: inline-block;
    margin-top: 28px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--blue-text);
  }

  .back { margin-top: 0; }

  .cross:hover,
  .back:hover { text-decoration: underline; text-underline-offset: 4px; }
</style>
