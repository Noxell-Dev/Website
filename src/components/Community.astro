---
import type { Lang } from "@i18n/ui";
import { useTranslations } from "@i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const rules = [
  "community.rule1",
  "community.rule2",
  "community.rule3",
  "community.rule4",
] as const;
---

<section class="section community" id="normas">
  <div class="wrap grid">
    <div class="copy" data-reveal>
      <span class="overline-pill">{t("community.overline")}</span>
      <h2>{t("community.title")}</h2>
      <p>{t("community.lead")}</p>
    </div>
    <ul class="rules" data-stagger>
      {rules.map((key) => <li>{t(key)}</li>)}
    </ul>
  </div>
</section>

<style>
  .community {
    border-top: 1px solid var(--border);
  }

  .grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 64px;
    align-items: start;
  }

  h2 {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 650;
    letter-spacing: -0.03em;
    margin: 16px 0 18px;
    max-width: 14em;
    text-wrap: balance;
  }

  .copy p:not(.overline) {
    color: var(--muted);
    max-width: 38em;
  }

  li {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--fg);
    border-top: 1px solid var(--border);
    padding: 16px 2px;
  }

  li:last-child {
    border-bottom: 1px solid var(--border);
  }

  li::before {
    content: "—";
    color: var(--red-text);
    margin-right: 12px;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
</style>
