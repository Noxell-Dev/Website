---
import type { Lang } from "@i18n/ui";
import { useTranslations } from "@i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const facts = ["about.fact1", "about.fact2", "about.fact3"] as const;
---

<section class="section section-breathe about" id="nosotros">
  <div class="wrap grid">
    <div class="copy" data-reveal>
      <span class="overline-pill">{t("about.overline")}</span>
      <h2>{t("about.title")}</h2>
      <p>{t("about.p1")}</p>
      <p>{t("about.p2")}</p>
    </div>
    <div class="aside">
      <p class="overline" data-reveal>{t("about.aside")}</p>
      <ul data-stagger>
        {facts.map((key) => <li>{t(key)}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--bg-2);
    border-block: 1px solid var(--border);
  }

  .grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 72px;
    align-items: start;
  }

  h2 {
    font-size: clamp(2rem, 3.4vw, 2.8rem);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.08;
    margin: 16px 0 26px;
    max-width: 15em;
    text-wrap: balance;
  }

  .copy p:not(.overline) {
    color: var(--muted);
    max-width: 40em;
  }

  .copy p + p:not(.overline) {
    margin-top: 14px;
  }

  .aside .overline {
    margin-bottom: 8px;
  }

  li {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--fg);
    border-top: 1px solid var(--border);
    padding: 17px 2px;
  }

  li:last-child {
    border-bottom: 1px solid var(--border);
  }

  li::before {
    content: "—";
    color: var(--blue-text);
    margin-right: 12px;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .section-breathe {
      padding-block: 92px;
    }
  }
</style>
